---
import Button from "@components/Button/Button.astro";
import MobileNav from "@components/Nav/MobileNav/MobileNav.astro";
import NavDropdown from "@components/Nav/NavDropdown/NavDropdown.astro";
import NavLink from "@components/Nav/NavLink.astro";
// import SiteLogo from "@components/SiteLogo/SiteLogo.astro";
import navData from "@config/navData.json";
import siteData from "@config/siteData.json";
import logo from "@images/LogoV11.png";
import logow from "@images/LogoV11W.png";
import { Image } from "astro:assets";

interface Props {
	startStyle?: "default" | "white"; // if set to "white", the nav elements will be white until the page is scrolled down. Useful for background hero images.
	rest?: any; // catch-all for any additional parameters, such as "aria-label"
}

const { startStyle = "default", rest } = Astro.props as Props;
---

<div
	id="nav__container"
	class="initial fixed top-0 left-0 z-30 flex w-full flex-col py-2 transition-[padding,background-color] duration-300"
	data-start-style={startStyle}
	transition:name={`nav`}
	{...rest}
>
	<div class="mx-auto flex w-full" class:list={[{ "text-base-900": startStyle === "default" }]}>
		<div class="site-container flex h-16 w-full items-center">
			<header class="flex w-full items-center gap-2">
				<!-- home button / image -->
				<div class="flex flex-auto justify-start">
					<a class="[#273fa3]focus flex items-center align-middle" href="/" aria-label="Home" class="">

						<Image
						id="site-logo"
						src={logo}
						alt="Aqualand Divers logo"
						loading="eager"
						width={495}
						height={128}
						class="h-14 w-28"
					/>
						<!--  <div class="font-heading-1 text-xl uppercase">{siteData.name}</div> -->
					</a>
				</div>

				<!-- desktop nav menu -->
				<div class="flex flex-auto justify-end lg:gap-4">
					<nav class="hidden md:block">
						<ul class="flex h-full items-center justify-center px-4 text-lg lg:gap-4">
							{
								// if dropdown exists, setup the dropdown, otherwise it is just a link
								navData.map((navItem) =>
									"dropdown" in navItem ? (
										// non-mobile dropdown menu
										<NavDropdown navItem={navItem} class="text-base-900" />
									) : (
										// normal nav link
										<NavLink {navItem} class="h-10" />
									),
								)
							}
						</ul>
					</nav>

					<!-- mobile nav menu, only load on small screens where it is visible -->
					<div class="md:hidden">
						<MobileNav />
					</div>
				</div>
			</header>
		</div>
	</div>
</div>

<script>
	let navbar: HTMLElement | null;
	let navCTA: HTMLElement | null;
	let logoImg: HTMLImageElement | null;
	const logoDark = "/images/LogoV11.png";
	const logoLight = "/images/LogoV11W.png";
	const brightnessThreshold = 145;
	let startStyle = "default";

	function setLogo(src: string) {
		if (!logoImg) return;

		if (logoImg.getAttribute("src") !== src) {
			logoImg.src = src;
			logoImg.removeAttribute("srcset");
			logoImg.removeAttribute("sizes");
		}
	}

	function getVisibleHeroImage() {
		const heroImages = Array.from(document.querySelectorAll<HTMLImageElement>("#hero img"));

		return (
			heroImages.find((image) => {
				const style = window.getComputedStyle(image);
				const rect = image.getBoundingClientRect();

				return style.display !== "none" && style.visibility !== "hidden" && rect.width > 0 && rect.height > 0;
			}) ?? null
		);
	}

	function getAverageBrightness(image: HTMLImageElement, sampleRect: DOMRect) {
		if (!image.complete || image.naturalWidth === 0 || image.naturalHeight === 0) return null;

		const imageRect = image.getBoundingClientRect();
		const overlapLeft = Math.max(sampleRect.left, imageRect.left);
		const overlapTop = Math.max(sampleRect.top, imageRect.top);
		const overlapRight = Math.min(sampleRect.right, imageRect.right);
		const overlapBottom = Math.min(sampleRect.bottom, imageRect.bottom);

		if (overlapRight <= overlapLeft || overlapBottom <= overlapTop) return null;

		const scale = Math.max(imageRect.width / image.naturalWidth, imageRect.height / image.naturalHeight);
		const renderedWidth = image.naturalWidth * scale;
		const renderedHeight = image.naturalHeight * scale;
		const offsetX = (imageRect.width - renderedWidth) / 2;
		const offsetY = (imageRect.height - renderedHeight) / 2;

		const sourceX = (overlapLeft - imageRect.left - offsetX) / scale;
		const sourceY = (overlapTop - imageRect.top - offsetY) / scale;
		const sourceW = (overlapRight - overlapLeft) / scale;
		const sourceH = (overlapBottom - overlapTop) / scale;

		if (sourceW <= 0 || sourceH <= 0) return null;

		const canvas = document.createElement("canvas");
		const width = Math.max(1, Math.round(overlapRight - overlapLeft));
		const height = Math.max(1, Math.round(overlapBottom - overlapTop));
		canvas.width = width;
		canvas.height = height;

		const ctx = canvas.getContext("2d", { willReadFrequently: true });
		if (!ctx) return null;

		ctx.drawImage(image, sourceX, sourceY, sourceW, sourceH, 0, 0, width, height);

		const { data } = ctx.getImageData(0, 0, width, height);
		let total = 0;
		let count = 0;

		for (let i = 0; i < data.length; i += 16) {
			const alpha = data[i + 3];
			if (alpha === 0) continue;

			const red = data[i];
			const green = data[i + 1];
			const blue = data[i + 2];
			total += 0.2126 * red + 0.7152 * green + 0.0722 * blue;
			count += 1;
		}

		return count > 0 ? total / count : null;
	}

	function updateLogoForBackground() {
		if (!logoImg) return;

		if (window.scrollY > 50) {
			setLogo(logoDark);
			return;
		}

		if (window.location.pathname !== "/") {
			setLogo(startStyle === "white" ? logoLight : logoDark);
			return;
		}

		if (startStyle === "white") {
			setLogo(logoLight);
			return;
		}

		const heroImage = getVisibleHeroImage();
		if (!heroImage) {
			setLogo(logoDark);
			return;
		}

		const brightness = getAverageBrightness(heroImage, logoImg.getBoundingClientRect());
		setLogo(brightness !== null && brightness >= brightnessThreshold ? logoDark : logoLight);
	}

	function scrollHandler() {
		if (!navbar) return;

		if (window.scrollY > 50) {
			// if we have scrolled down the page a bit, adjust colors
			navbar.classList.add("scrolled");
			navbar.classList.remove("initial");
			navCTA?.setAttribute("data-scrolled", "true");
		} else {
			navbar.classList.add("initial");
			navbar.classList.remove("scrolled");
			navCTA?.setAttribute("data-scrolled", "false");
		}

		updateLogoForBackground();
	}

	function initNav() {
		navbar = document.getElementById("nav__container");
		logoImg = document.getElementById("site-logo") as HTMLImageElement | null;
		navCTA = navbar?.querySelector(".nav__cta") as HTMLElement | null;
		startStyle = navbar?.dataset.startStyle ?? "default";

		window.removeEventListener("scroll", scrollHandler);
		window.removeEventListener("resize", scrollHandler);
		window.removeEventListener("load", scrollHandler);

		window.addEventListener("scroll", scrollHandler, { passive: true });
		window.addEventListener("resize", scrollHandler, { passive: true });
		window.addEventListener("load", scrollHandler, { once: true });

		scrollHandler();
	}

	// runs on initial page load
	initNav();

	// runs on view transitions navigation. Not needed if item has "transition:persist"
	document.addEventListener("astro:after-swap", initNav);
</script>

<style>
	#nav__container.initial {
		/* @apply text-white; */
		color: white;
	}

	#nav__container.scrolled {
		/* @apply bg-base-50 py-0; */
		background-color: var(--color-base-50);
		padding-block: 0;
	}
</style>
