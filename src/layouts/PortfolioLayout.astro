---
import Contact from "@components/Contact/Contact.astro";
import PortfolioImage from "@components/PorfolioImage/PortfolioImage.astro";
import PortfolioGrid from "@components/Portfolio/PortfolioGrid.astro";
import { Image } from "astro:assets";
import { type CollectionEntry, getCollection } from "astro:content";

import BaseLayout from "./BaseLayout.astro";

interface Props {
	portfolio: CollectionEntry<"portfolios">;
}

import headerImage from "@images/portfolio-header-crop-min.jpg";

const { portfolio } = Astro.props as Props;
const { title, description, images = [], heroImage, sub, header } = portfolio.data; //date, clients removed

const escapeHtml = (value: string) =>
	value
		.replaceAll("&", "&amp;")
		.replaceAll("<", "&lt;")
		.replaceAll(">", "&gt;")
		.replaceAll('"', "&quot;")
		.replaceAll("'", "&#39;");

const allowedTags = new Set(["h1", "h2", "h3", "h4", "h5", "h6", "p", "a", "img", "br", "div", "section"]);
const selfClosingTags = new Set(["img", "br"]);

const buildBodyHtml = (body: string | undefined) => {
	const lines = (body ?? "").split(/\r?\n/);
	const output: string[] = [];
	const openTagStack: string[] = [];
	const tagRegex = /<\s*(\/?)\s*([a-zA-Z][\w-]*)\b[^>]*?>/g;

	for (const rawLine of lines) {
		const line = rawLine.trim();
		if (!line) {
			continue;
		}

		const tags = [...line.matchAll(tagRegex)];
		const hasTags = tags.length > 0;
		const hasDisallowedTag = tags.some((match) => !allowedTags.has(match[2].toLowerCase()));
		const insideHtmlBlock = openTagStack.length > 0;

		if (hasTags && !hasDisallowedTag) {
			output.push(line);

			for (const match of tags) {
				const isClosing = match[1] === "/";
				const tag = match[2].toLowerCase();
				const fullTag = match[0];
				const isSelfClosing = selfClosingTags.has(tag) || /\/\s*>$/.test(fullTag);

				if (isSelfClosing) {
					continue;
				}

				if (isClosing) {
					for (let i = openTagStack.length - 1; i >= 0; i--) {
						if (openTagStack[i] === tag) {
							openTagStack.splice(i, 1);
							break;
						}
					}
				} else {
					openTagStack.push(tag);
				}
			}

			continue;
		}

		if (insideHtmlBlock) {
			output.push(escapeHtml(line));
		} else {
			output.push(`<p>${escapeHtml(line)}</p>`);
		}
	}

	return output.join("\n");
};

const portfolioBodyHtml = buildBodyHtml(portfolio.body);

// find other portfolios to show later down the page
const otherPortfolios = await getCollection("portfolios", (otherPortfolio) => {
	// filter out draft pages
	return otherPortfolio.data.draft !== false && otherPortfolio.id !== portfolio.id;
});
---

<BaseLayout
	type="general"
	title={title}
	description={description}
	heroImage={heroImage}
	navStartStyle="white"
>

	<section id="hero" class="relative z-10 flex min-h-[45lvh] w-full">
		<!-- background image -->
		<div class="absolute -z-10 h-full min-h-full overflow-hidden w-full">
			<div class="absolute inset-0 bg-black/10 mix-blend-hard-light"></div>
			<Image
				src={heroImage}
				class="hidden h-full w-full object-cover object-bottom sm:block bg-transparent"
				alt="diving"
				aria-hidden="false"
				loading="eager"
				width={1920}
			/>
			<Image
				src={heroImage}
				class="h-full w-full object-cover sm:hidden"
				alt="diving"
				aria-hidden="true"
				loading="eager"
				width={600}
			/>
		</div>

		<!-- hero items -->
		<div class="site-container relative w-full gap-10 py-44 text-center md:py-52 md:text-left">
			<!-- Hero text -->
			<div class="text-base-50 my-auto mr-auto max-w-[800px] flex-col">
				<h1
					class="font-heading-1 text-4xl font-semibold text-pretty md:text-7xl"
				>
					{title}
				</h1>
			<p
				class="mt-8 text-lg tracking-widest text-pretty drop-shadow-[0_1px_1px_rgba(0,0,0,0.2)] md:max-w-[550px] md:text-2xl"
			>
				{sub}
			</p>
			</div>
		</div>
	</section>

	<article class="mx-auto mt-12 px-4 md:mt-20 md:max-w-6xl">

		<!-- hero image -->
		<!-- <div class="mt-6 h-auto max-h-[50vh] w-full overflow-hidden md:max-h-[80vh]">
			<Image
				src={heroImage}
				alt={`cover for ${title}`}
				width={1120}
				quality="high"
				densities={[1.5, 2]}
				class="h-auto min-h-full w-full min-w-full object-cover"
				transition:name={`portfolio-image-${portfolio.id}`}
			/>
		</div> -->

		<!-- people and location
		<h2
			class="h3 text-[#273fa3] mt-10 flex flex-col items-center justify-center gap-x-3 gap-y-1 tracking-widest md:flex-row"
		>
			<div>
				{clients.join(" & ")}
			</div>
			<span class="hidden md:inline">|</span>
			<hr class="border-[#273fa3]400 w-1/3 md:hidden" />
			<span>{location}</span>
		</h2> -->

		<!-- slot really only fuctions as a longer description -->
		<div class="description markdown-content text-center text-pretty md:text-lg md:text-4x1" set:html={portfolioBodyHtml}>
		</div>

		<!-- portfolio images -->
		<div class="mx-auto mt-12 max-w-5xl space-y-6 md:mt-20 md:space-y-16">
			{
				images.map((imageGroup) => (
					<div
						class:list={[
							"mb-6 grid gap-6 md:gap-16",
							{
								"grid-cols-1": imageGroup.length === 1,
								"grid-cols-2": imageGroup.length === 2,
								"grid-cols-3": imageGroup.length === 3,
							},
						]}
					>
						{imageGroup.map((image) => (
							<PortfolioImage image={image} numCols={imageGroup.length} />
						))}
					</div>
				))
			}
		</div>
	</article>

	<section class="mx-auto mt-12 px-4 md:mt-16 md:max-w-5xl">
		<h3 class="h2 text-center">More Courses & Services</h3>
		<PortfolioGrid portfolios={otherPortfolios} noTransitions />
	</section>
	<Contact class="mt-12" />
</BaseLayout>
